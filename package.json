{
  "name": "@onchaindiligence/sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for OnChainDiligence — policy preflight, recoverable agent payment lifecycles, independent settlement observation, and verifiable receipts.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./commerce/node": {
      "types": "./dist/commerce/nodeFileRecoveryStore.d.ts",
      "import": "./dist/commerce/nodeFileRecoveryStore.js"
    }
  },
  "files": [
    "dist",
    "conformance/*.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent-payments",
    "ai-agents",
    "x402",
    "402",
    "payments",
    "receipts",
    "verification",
    "mcp",
    "base",
    "usdc",
    "web3",
    "compliance",
    "sanctions",
    "ofac",
    "mppx",
    "tempo",
    "agent"
  ],
  "license": "MIT",
  "peerDependencies": {
    "mppx": "^0.7.0",
    "viem": "^2.56.0"
  },
  "dependencies": {
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
